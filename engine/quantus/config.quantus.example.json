{
  "coin": {
    "name": "Quantus",
    "symbol": "QTC"
  },
  "engine": "quantus",
  "algorithm": {
    "name": "poseidon2"
  },
  "disablePayment": true,
  "poolAddress": {
    "address": "SET_REWARDS_IN_QUANTUS_NODE"
  },
  "rewardRecipients": [],
  "jobRebroadcastTimeout": 55,
  "connectionTimeout": 600,
  "banning": {
    "time": 600,
    "invalidPercent": 50,
    "checkThreshold": 500,
    "purgeInterval": 300
  },
  "ports": {
    "3333": {
      "diff": 1000,
      "varDiff": null,
      "tls": {
        "certFile": "quantus-pool-cert.pem",
        "keyFile": "quantus-pool-key.pem"
      },
      "protocol": "quic"
    },
    "3334": {
      "protocol": "stratum",
      "diff": 1000,
      "varDiff": null,
      "tls": null
    },
    "3335": {
      "protocol": "stratum",
      "diff": 1000,
      "varDiff": null,
      "tls": {
        "certFile": "quantus-pool-cert.pem",
        "keyFile": "quantus-pool-key.pem"
      }
    }
  },
  "daemons": [],
  "p2p": null,
  "api": {
    "host": "0.0.0.0",
    "port": 20000
  },
  "storage": {
    "network": "tcp",
    "host": "127.0.0.1",
    "port": 6379,
    "tls": null
  },
  "quantus": {
    "nodeAddress": "127.0.0.1:9833",
    "authTokenFile": "/path/to/node/chains/CHAIN/miner-auth-token",
    "tlsCertSHA256File": "/path/to/node/chains/CHAIN/miner-tls-cert-sha256"
  }
}
